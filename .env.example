VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_ADMIN_EMAIL=your@gmail.com

# אופציונלי — ניטור שגיאות בפרודקשן (Sentry)
# VITE_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# לייבוא/סנכרון CLI (scripts/import-*.mjs, scripts/resync-from-sheets.mjs, scripts/seed-demo-users.mjs) — לא ב-client
# חובה: אותו פרויקט כמו VITE_SUPABASE_URL (ref ב-JWT חייב להתאים)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Sentry source maps (Vercel build בלבד — לא ב-client)
# SENTRY_AUTH_TOKEN=your-sentry-auth-token
# SENTRY_ORG=your-org
# SENTRY_PROJECT=pool-app

# אופציונלי — כתובת חזרה מפורשת אחרי Google (פיתוח מקומי)
# VITE_AUTH_REDIRECT_URL=http://localhost:5173/

# אופציונלי — סרטון YouTube/Vimeo לדף נחיתה מבדק (/register/assessment)
# VITE_LANDING_VIDEO_URL=https://www.youtube.com/embed/VIDEO_ID

# WhatsApp Business API — בפרודקשן: Supabase Edge Functions → Secrets (לא ב-client)
# WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token
# WHATSAPP_ACCESS_TOKEN=your-meta-access-token
# WHATSAPP_PHONE_NUMBER_ID=1118787068792338
# WHATSAPP_BUSINESS_ACCOUNT_ID=1370606501650491
# WHATSAPP_GRAPH_API_VERSION=v25.0
# WHATSAPP_SEND_SECRET=streamline-wa-send-2026-xK9m

# אופציונלי — Supabase CLI (ל-advisors remote)
# SUPABASE_ACCESS_TOKEN=your-access-token

# E2E_TEST_EMAIL=demo.admin@demo.streamline
# E2E_TEST_PASSWORD=Demo1234!

# Fixtures ל-E2E (npm run seed:e2e — ערכים קבועים, או מה-seed)
# E2E_QR_TOKEN=e2e00001-0000-4000-8000-000000000001
# E2E_SEARCH_PHONE=0501111999
# E2E_LESSON_ID=e2e00002-0000-4000-8000-000000000002
# E2E_PASS_TOKEN=e2e00003-0000-4000-8000-000000000003
# E2E_PASS_QR_TOKEN=e2e00004-0000-4000-8000-000000000004
# E2E_GROUP_SESSION_ID=e2e00005-0000-4000-8000-000000000005

# Hook לסריקת QR בבדיקות (מוגדר אוטומטית ב-playwright.config.js)
# VITE_E2E_HOOKS=true

# חובה ב-Supabase → Authentication → URL Configuration → Redirect URLs:
#   http://localhost:5173/**
#   http://127.0.0.1:5173/**
#   https://your-app.vercel.app/**
