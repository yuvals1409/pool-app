VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_ADMIN_EMAIL=your@gmail.com

# לייבוא/סנכרון CLI (scripts/import-*.mjs, scripts/resync-from-sheets.mjs) — לא ב-client
# חובה: אותו פרויקט כמו VITE_SUPABASE_URL (ref ב-JWT חייב להתאים)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# אופציונלי — כתובת חזרה מפורשת אחרי Google (פיתוח מקומי)
# VITE_AUTH_REDIRECT_URL=http://localhost:5173/

# WhatsApp Business API — רק ב-Supabase Edge Functions → Secrets (לא ב-client)
# WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token
# WHATSAPP_ACCESS_TOKEN=your-meta-access-token
# WHATSAPP_PHONE_NUMBER_ID=1118787068792338
# WHATSAPP_GRAPH_API_VERSION=v25.0
# WHATSAPP_SEND_SECRET=streamline-wa-send-2026-xK9m

# Google Sheets — מאסטר סנכרון (CLI: build-master-sheet.mjs, sync-master-sheet.mjs)
# Edge Function secrets: sync-google-sheets
# SHEETS_SPREADSHEET_ID=your-master-spreadsheet-id
# SHEETS_LEADS_SPREADSHEET_ID=your-tc-leads-spreadsheet-id
# Master sheet V2 tabs (in workbook "Stream Line מאסטר")
# SHEETS_GROUPS_TAB=קבוצות
# SHEETS_SLOTS_TAB=משבצות_קבוצות
# SHEETS_USERS_TAB=משתמשים
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# VITE_SHEETS_SPREADSHEET_ID=your-master-spreadsheet-id
# שתפו את שני הגיליונות עם client_email של ה-Service Account (Editor)
# סנכרון יומי: Supabase Dashboard → Cron → POST /functions/v1/sync-google-sheets
#   body: {"mode":"master","direction":"pull"}  schedule: 0 5 * * *

# חובה ב-Supabase → Authentication → URL Configuration → Redirect URLs:
#   http://localhost:5173/**
#   http://127.0.0.1:5173/**
#   https://your-app.vercel.app/**
