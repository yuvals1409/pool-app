{
  "name": "pool-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "seed:demo": "node scripts/seed-demo-users.mjs",
    "seed:e2e": "node scripts/seed-e2e-fixtures.mjs",
    "db:baseline": "node scripts/build-baseline-migration.mjs",
    "db:advisors": "node scripts/db-advisors.mjs",
    "db:advisors:security": "node scripts/db-advisors.mjs --type security",
    "db:advisors:remote": "node scripts/db-advisors.mjs --linked",
    "db:rls": "node scripts/rls-supashield.mjs",
    "db:rls:audit": "node scripts/rls-supashield.mjs --audit",
    "db:rls:coverage": "node scripts/rls-supashield.mjs --coverage",
    "tools:verify": "node scripts/verify-dev-tools.mjs",
    "lint": "eslint src supabase/functions",
    "lint:fix": "eslint src supabase/functions --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc -p jsconfig.json --noEmit",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx}": "eslint --fix"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/ibm-plex-sans-hebrew": "^5.2.8",
    "@sentry/react": "^10.62.0",
    "@supabase/supabase-js": "^2.110.0",
    "@vercel/analytics": "^2.0.1",
    "framer-motion": "^12.42.2",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.18.0",
    "qrcode": "^1.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.55.0",
    "@sentry/vite-plugin": "^5.3.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "supashield": "^0.3.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.62.1",
    "vite": "^5.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7"
  }
}
