{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "types": ["vite/client"]
  },
  "include": ["src/lib/**/*.js", "src/lib/globals.d.ts"],
  "exclude": ["src/lib/**/*.test.js", "src/lib/**/*.jsx", "src/lib/chartTheme.js"]
}
